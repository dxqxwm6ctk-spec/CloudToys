# Cloud Toys API Server — required environment variables
# Copy this file to `.env` for local reference only; on Render/Railway set
# these in the service's Environment Variables panel (never commit secrets).

# ── Database ─────────────────────────────────────────────────────────────
# This project now uses Supabase Postgres (development and should also be
# used for the deployed API server on Render/Railway).
# IMPORTANT: use the "Transaction pooler" (or "Session pooler") connection
# string from Supabase → Project Settings → Database → Connection string —
# NOT the "Direct connection" string. The direct-connection hostname
# (db.<ref>.supabase.co) only has an IPv6 address, which most hosts
# (including this Replit environment, Render, and Railway) cannot reach.
# The pooler hostname (aws-0-<region>.pooler.supabase.com) supports IPv4.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Sessions / cookies ───────────────────────────────────────────────────
# Used to sign the admin session cookie. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# ── Admin login ──────────────────────────────────────────────────────────
# Credentials for the single admin account used by the Cloud Toys Admin app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of the exact origins allowed to call this API
# (no trailing slash). Must include both deployed frontend URLs.
ALLOWED_ORIGINS=https://cloud-toys.netlify.app,https://cloud-toys-admin.netlify.app

# ── Object storage (product image uploads) ──────────────────────────────
# NOTE: on Replit these are wired to Replit's built-in Object Storage via an
# internal sidecar and require NO extra setup. That sidecar does not exist
# on Render/Railway — image uploads will not work there until the storage
# integration is swapped for standard Google Cloud credentials (or another
# provider). See DEPLOYMENT.md for details before relying on this feature
# outside Replit.
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=

# ── Misc ─────────────────────────────────────────────────────────────────
# Render/Railway inject PORT automatically — do not set it manually.
# LOG_LEVEL=info
