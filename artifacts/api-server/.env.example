# Cloud Toys API Server — required environment variables
# Copy this file to `.env` for local reference only; on Heroku set
# these in Settings → Config Vars (never commit secrets).

# ── Database ─────────────────────────────────────────────────────────────
# Use the Supabase "Transaction pooler" (or "Session pooler") connection
# string from Supabase → Project Settings → Database → Connection string.
# Do NOT use the "Direct connection" string — it uses IPv6 which Heroku
# dynos cannot reach. The pooler hostname (aws-0-<region>.pooler.supabase.com)
# supports IPv4 and works correctly.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Sessions / cookies ───────────────────────────────────────────────────
# Used to sign the admin session cookie. Use a long random string.
SESSION_SECRET=replace-with-a-long-random-string

# ── Admin login ──────────────────────────────────────────────────────────
# Credentials for the single admin account used by the Cloud Toys Admin app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of the exact origins allowed to call this API
# (no trailing slash). Must include both deployed Netlify frontend URLs.
ALLOWED_ORIGINS=https://cloud-toys.netlify.app,https://cloud-toys-admin.netlify.app

# ── Object storage (product image uploads) ──────────────────────────────
# NOTE: on Replit these are wired to Replit's built-in Object Storage via an
# internal sidecar and require NO extra setup. That sidecar does not exist
# on Heroku — image uploads will not work until the storage integration is
# swapped for standard cloud storage credentials (e.g. Google Cloud Storage,
# AWS S3, or Cloudinary). See DEPLOYMENT.md for details.
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=

# ── Misc ─────────────────────────────────────────────────────────────────
# Heroku injects PORT automatically — do not set it manually.
# LOG_LEVEL=info
